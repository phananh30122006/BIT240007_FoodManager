<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header / Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarMain"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary"
                app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAppTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_dishes"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudentInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_info"
                            android:textColor="#FFECB3"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Manage Categories Button -->
                    <Button
                        android:id="@+id/btnNavCategories"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_categories"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <!-- Language Switcher Button -->
                    <Button
                        android:id="@+id/btnLanguageToggle"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/switch_language"
                        android:textColor="@android:color/white"
                        app:strokeColor="@android:color/white"
                        android:textSize="11sp" />

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <!-- Sync / Network Status Banner -->
            <LinearLayout
                android:id="@+id/layoutSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2E7D32"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_available" />

                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_online"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <!-- MockAPI Configuration / Sync button -->
                <TextView
                    android:id="@+id/tvConfigureMockApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mockapi_settings"
                    android:textColor="#FFE082"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Search and Filter Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:elevation="2dp"
            android:padding="10dp">

            <!-- Search Input Box -->
            <EditText
                android:id="@+id/etSearchDish"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_search_input"
                android:hint="@string/search_hint"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp" />

            <!-- Filters Row 1: Category & Availability -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spCategoryFilter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOnlyAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_only_available"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Filters Row 2: Price Range & Sort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etMinPrice"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="@string/filter_min_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="8dp"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text="-" />

                <EditText
                    android:id="@+id/etMaxPrice"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="@string/filter_max_price"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="8dp"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spSortOrder"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.4"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_input" />

                <Button
                    android:id="@+id/btnResetFilter"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/btn_reset"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Dish List & Empty View -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDishes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="80dp" />

            <TextView
                android:id="@+id/tvEmptyDishes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/empty_dishes"
                android:textColor="@color/text_hint"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- FAB to Add New Dish -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddDish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/btn_add_dish"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
